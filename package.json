    ],
    "files": [
      "main/**/*",
      "renderer/**/*",
      "bin/**/*",
      "preload.js",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "electronLanguages": ["en-US"]
  },
  "keywords": [],
  "author": "Ayinaki",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-store": "^8.1.0"
  }
}
