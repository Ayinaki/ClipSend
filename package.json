{
  "name": "video-compressor",
  "version": "2.0.0",
  "description": "",
  "main": "main/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "esbuild renderer/app.js --bundle --format=esm --outfile=renderer/dist/app.bundle.js && esbuild renderer/app.js --bundle --format=cjs --outfile=renderer/dist/app.bundle.cjs",
    "build": "npm run build:renderer && electron-builder build --win --publish never",
    "test": "npm run build:renderer && jest"
  },
  "jest": {
    "transform": {
      "renderer[\\\\/].*\\.js$": "<rootDir>/test/renderer/esbuild-transform.js",
      "\\.[jt]sx?$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.freebuff/"
    ]
  },
  "build": {
    "appId": "com.clipsend.app",
    "productName": "ClipSend",
    "artifactName": "${productName}.Setup.${version}.${ext}",
    "win": {
      "icon": "build/icon.png"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "bin/**/*",
      "preload.js",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ]
  },
  "keywords": [],
  "author": "Ayinaki",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "babel-jest": "^30.4.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Ayinaki",
      "repo": "ClipSend"
    }
  ]
}
