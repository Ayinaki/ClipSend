{
  "name": "video-compressor",
  "version": "1.8.16",
  "description": "",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "test": "jest"
  },
  "build": {
    "appId": "com.clipsend.app",
    "productName": "ClipSend",
    "win": {
      "icon": "build/icon.png"
